{
  "name": "@hello.nrfcloud.com/proto-map",
  "version": "0.0.0-development",
  "description": "Documents the communication protocol between devices, the hello.nrfcloud.com/map backend and web application",
  "type": "module",
  "exports": {
    "./*": {
      "default": "./dist/*/index.js",
      "types": "./*/index.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hello-nrfcloud/proto-map.git"
  },
  "bugs": {
    "url": "https://github.com/hello-nrfcloud/proto-map/issues"
  },
  "homepage": "https://hello.nrfcloud.com",
  "keywords": [
    "nordicsemiconductor",
    "cellular-iot",
    "hello-nrfcloud",
    "hello-nrfcloud-map"
  ],
  "author": "Nordic Semiconductor ASA | nordicsemi.no",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "scripts": {
    "prepare": "husky && case \"$npm_command\" in install|ci) check-node-version --package ;; esac",
    "test": "npx globstar -- node --experimental-transform-types --no-warnings --test --test-reporter spec \"!(node_modules)/**/*.spec.ts\"",
    "prepublishOnly": "./compile.sh"
  },
  "devDependencies": {
    "@bifravst/eslint-config-typescript": "7.0.34",
    "@bifravst/prettier-config": "1.1.17",
    "@commitlint/config-conventional": "21.2.2",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.47",
    "@types/node": "26.2.0",
    "@types/xml2js": "0.4.14",
    "@typescript/native": "npm:typescript@7.0.2",
    "chalk": "6.0.0",
    "check-node-version": "4.2.1",
    "globstar": "1.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "remark": "15.0.1",
    "remark-frontmatter": "5.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "xml2js": "0.6.2",
    "yaml": "2.9.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint"
    ],
    "*.{md,json,yaml,yml,html}": [
      "prettier --write"
    ],
    "*.xml": [
      "./lwm2m/format.sh"
    ]
  },
  "prettier": "@bifravst/prettier-config",
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false,
          "failTitle": false
        }
      ]
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "api",
    "senml",
    "models",
    "lwm2m"
  ],
  "peerDependencies": {
    "@aws-sdk/client-timestream-write": "^3.1057.0",
    "@sinclair/typebox": "^0.34.52"
  }
}
